{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://system-design-academy.invalid/schemas/task.schema.json",
  "title": "System Design Academy Task State v2",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "module_id",
    "owner",
    "spec_path",
    "automation_status",
    "steps"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "module_id": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "spec_path": {
      "type": "string",
      "minLength": 1
    },
    "automation_status": {
      "enum": [
        "not_started",
        "in_progress",
        "blocked",
        "automation_complete"
      ]
    },
    "current_phase": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "step_id",
          "title",
          "status",
          "depends_on",
          "definition_version",
          "input_paths",
          "output_paths"
        ],
        "properties": {
          "step_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pending",
              "running",
              "completed",
              "invalidated",
              "blocked"
            ]
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "definition_version": {
            "type": "string",
            "minLength": 1
          },
          "input_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "output_paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "requires_reviews": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "revision_cycle": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2
          },
          "review": {
            "type": "object",
            "required": [
              "artifact_paths",
              "verdict_path"
            ],
            "additionalProperties": false,
            "properties": {
              "artifact_paths": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "verdict_path": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "additionalProperties": true
      }
    },
    "execution_control": {
      "enum": [
        "active",
        "paused",
        "awaiting-human"
      ]
    },
    "control_reason": {
      "type": "string",
      "minLength": 1
    },
    "review_status": {
      "enum": [
        "not_reviewed",
        "in_review",
        "reviewed",
        "needs_review"
      ]
    },
    "review_reason": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
